APP_NAME="Talent Platform API"
APP_ENV="dev"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talent_platform"

# Dual fallback config for student simulator:
# 1) openai real eval -> 2) backend mock eval -> 3) frontend local mock
# LangGraph 剧情/简历 Agent 真 ReAct 需 AI_PROVIDER=openai 且配置 OPENAI_API_KEY
# RESUME_OPTIMIZER_ENGINE=langgraph（默认）| legacy（旧 for 循环）
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4.1-mini"
LLM_TIMEOUT_SECONDS="30"

# 高校端/企业端试用门禁密钥（登录、注册、公司注册均须校验）
TRIAL_DEVELOPER_KEY="psq12345"
