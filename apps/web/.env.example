DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talent_platform"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"

AUTH_SECRET="please-change-me-to-a-long-random-string"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-chat"
# Agent 路由服务端调用 FastAPI（默认同 NEXT_PUBLIC_API_BASE_URL）
API_BASE_URL="http://127.0.0.1:8000/api/v1"
# 剧情 Agent 引擎：langgraph（FastAPI 后端，默认）| next（Next.js 本地 ReAct）
SIMULATION_AGENT_ENGINE=langgraph
# 简历优化 Agent：langgraph（默认）| next | legacy（Python for 循环旧版）
RESUME_OPTIMIZER_ENGINE=langgraph
