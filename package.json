{
  "name": "talent-platform-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @platform/web",
    "dev:api": "python -m uvicorn app.main:app --reload --port 8000 --app-dir apps/api",
    "build:web": "npm run build --workspace @platform/web",
    "lint:web": "npm run lint --workspace @platform/web"
  }
}
