# 复制为 .env 供 docker compose 本地验证，或对照填写到 Sealos 控制台环境变量
#
# Sealos 镜像名（GitHub Actions 构建后，用户名改为你自己的、小写）：
#   ghcr.io/harryfox-tech/adaptlink-api:latest
#   ghcr.io/harryfox-tech/adaptlink-web:latest

# ── 后端 adaptlink-api ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname
AI_PROVIDER=mock
TRIAL_DEVELOPER_KEY=psq12345
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ── 前端 adaptlink-web（构建参数 + 运行时）──
# 填 Sealos 上 API 服务的公网 HTTPS 地址 + /api/v1
NEXT_PUBLIC_API_BASE_URL=https://你的-api-域名.cloud.sealos.io/api/v1
# Agent 服务端调用 FastAPI（可与上一项相同）
API_BASE_URL=https://你的-api-域名.cloud.sealos.io/api/v1
# Simulation React Agent 真推理（与 API 可共用同一密钥）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

